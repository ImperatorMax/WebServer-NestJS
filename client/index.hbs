<!doctype html>
<html lang="en">
    <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/index.css" />
    <title>Web server kind of site</title>
    </head>
    <body>
    <div class="hero">
        <span class="badge">Онлайн</span>
        <h1>
        <span class="dim">Welcome to</span><br>
